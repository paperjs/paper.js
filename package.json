{
  "name": "paper",
  "version": "0.17.0",
  "description": "The Swiss Army Knife of Vector Graphics Scripting",
  "license": "MIT",
  "homepage": "http://paperjs.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/paperjs/paper.js"
  },
  "bugs": "https://github.com/paperjs/paper.js/issues",
  "contributors": [
    "Jürg Lehni <juerg@scratchdisk.com> (http://scratchdisk.com)",
    "Jonathan Puckey <jonathan@puckey.studio> (http://studiomoniker.com)"
  ],
  "type": "module",
  "main": "./dist/esm/paper.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/paper.js"
    },
    "./core": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/paper.js"
    },
    "./paperscript": {
      "types": "./dist/types/paperscript/index.d.ts",
      "default": "./dist/esm/paperscript.js"
    },
    "./node": {
      "types": "./dist/types/node/index.d.ts",
      "default": "./dist/esm/node.js"
    },
    "./hosted": {
      "types": "./dist/types/hosted/index.d.ts",
      "default": "./dist/esm/hosted.js"
    },
    "./dist/paper-core": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/paper.js"
    },
    "./dist/*.js": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "zip": "rm -f dist/paperjs.zip && zip -qr dist/paperjs.zip dist/paper-*.js dist/paper-*.js.map LICENSE.txt examples",
    "release": "node release.mjs",
    "eslint": "eslint src test '*.mjs'",
    "test": "vitest run --project node --project browser",
    "test:browser": "vitest run --project browser",
    "test:booleans": "node test/booleans/run.mjs",
    "test:coverage": "vitest run --project node --project browser --coverage --testTimeout=60000",
    "test:node": "vitest run --project node",
    "test:screenshots": "sh test/screenshots/docker.sh",
    "prepare": "husky"
  },
  "files": [
    "AUTHORS.md",
    "CHANGELOG.md",
    "dist/esm/",
    "dist/paper-*.js",
    "dist/paper-*.js.map",
    "dist/types/",
    "LICENSE.txt",
    "README.md"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.1.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-penere": "^0.5.0",
    "resemblejs": "^3.2.5",
    "rolldown": "1.2.14",
    "stats.js": "^0.17.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "vector",
    "graphic",
    "graphics",
    "2d",
    "geometry",
    "bezier",
    "curve",
    "curves",
    "path",
    "paths",
    "canvas",
    "svg",
    "paper",
    "paper.js",
    "paperjs"
  ],
  "packageManager": "pnpm@12.9.0",
  "dependencies": {
    "acorn": "~8.15.0"
  },
  "peerDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "happy-dom": "^21.0.4"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    }
  }
}
