{
  // The declarations of the entries, see `exports` in package.json:
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist/types"
  },
  // The globals of PaperScript are declared for the docs only:
  "exclude": ["src/docs"]
}
