root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.json]
indent_size = 2

# The tests and their configuration follow dito.js's style, see
# prettier.config.mjs, and so will the sources:
[{test/**.js,*.mjs,test/**.mjs}]
indent_size = 2
max_line_length = 80

[*.md]
trim_trailing_whitespace = false
