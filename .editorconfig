root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.json]
indent_size = 2

# The sources, the tests, the scripts and their configuration follow dito.js's style, see
# prettier.config.mjs:
[{src/**.{js,ts},test/**.{js,ts},*.mjs,test/**.mjs,docs/*.mjs}]
indent_size = 2
max_line_length = 80

[*.md]
trim_trailing_whitespace = false
